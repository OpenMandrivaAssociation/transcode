--- a/libtc/ffmpeg9compat.h	2026-08-12 00:22:09.765536733 +0200
+++ b/libtc/ffmpeg9compat.h	2026-08-14 19:26:05.927328179 +0200
@@ -0,0 +1,69 @@
+#ifndef TRANSCODE_FFMPEG9COMPAT_H
+#define TRANSCODE_FFMPEG9COMPAT_H
+
+#include <string.h>
+#include <errno.h>
+#include <libavcodec/avcodec.h>
+#include <libavutil/imgutils.h>
+
+#ifndef AVPicture
+typedef AVFrame AVPicture;
+#endif
+
+#ifndef avcodec_register_all
+#define avcodec_register_all() ((void)0)
+#endif
+
+static inline void tc_av_init_packet(AVPacket *pkt)
+{
+	memset(pkt, 0, sizeof(*pkt));
+	pkt->pts = pkt->dts = AV_NOPTS_VALUE;
+}
+
+static inline int tc_avpicture_fill(AVFrame *pic, uint8_t *ptr, int fmt, int w, int h)
+{
+	return av_image_fill_arrays(pic->data, pic->linesize, ptr, (enum AVPixelFormat)fmt, w, h, 1);
+}
+
+static inline int tc_encode_video2(AVCodecContext *avctx, AVPacket *pkt,
+				   const AVFrame *frame, int *got)
+{
+	int ret = avcodec_send_frame(avctx, frame);
+	*got = 0;
+	if (ret < 0 && ret != AVERROR_EOF)
+		return ret;
+	ret = avcodec_receive_packet(avctx, pkt);
+	if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
+		return 0;
+	if (ret < 0)
+		return ret;
+	*got = 1;
+	return 0;
+}
+
+static inline int tc_decode_video2(AVCodecContext *avctx, AVFrame *frame,
+				   int *got, AVPacket *pkt)
+{
+	int ret;
+	*got = 0;
+	ret = avcodec_send_packet(avctx, pkt);
+	if (ret < 0 && ret != AVERROR(EAGAIN) && ret != AVERROR_EOF)
+		return ret;
+	ret = avcodec_receive_frame(avctx, frame);
+	if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
+		return 0;
+	if (ret < 0)
+		return ret;
+	*got = 1;
+	return pkt ? pkt->size : 0;
+}
+
+#define av_init_packet(p) tc_av_init_packet(p)
+#define avpicture_fill(pic, ptr, fmt, w, h) tc_avpicture_fill((AVFrame *)(pic), ptr, fmt, w, h)
+#define avcodec_encode_video2(c, p, f, g) tc_encode_video2((c), (p), (f), (g))
+#define avcodec_decode_video2(c, f, g, p) tc_decode_video2((c), (f), (g), (p))
+#define avcodec_close(c) ((void)(c), 0)
+#define avcodec_get_context_defaults(c) memset((c), 0, sizeof(*(c)))
+#define avcodec_get_context_defaults3(c, codec) memset((c), 0, sizeof(*(c)))
+
+#endif
