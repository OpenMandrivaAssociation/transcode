+static inline int tc_encode_audio(AVCodecContext *avctx, uint8_t *buf, int buf_size, const short *samples)
+{
+	AVFrame *frame;
+	AVPacket pkt;
+	int ret, got = 0;
+	int nb_ch, bps, nbytes;
+
+	tc_av_init_packet(&pkt);
+	pkt.data = buf;
+	pkt.size = buf_size;
+
+	frame = av_frame_alloc();
+	if (!frame)
+		return AVERROR(ENOMEM);
+	nb_ch = avctx->ch_layout.nb_channels;
+	if (nb_ch <= 0)
+		nb_ch = 2;
+	bps = av_get_bytes_per_sample(avctx->sample_fmt);
+	if (bps <= 0)
+		bps = 2;
+	frame->nb_samples = avctx->frame_size;
+	frame->format = avctx->sample_fmt;
+	frame->ch_layout = avctx->ch_layout;
+	nbytes = avctx->frame_size * nb_ch * bps;
+	ret = avcodec_fill_audio_frame(frame, nb_ch, avctx->sample_fmt,
+				       (const uint8_t *)samples, nbytes, 1);
+	if (ret < 0) {
+		av_frame_free(&frame);
+		return ret;
+	}
+	ret = tc_encode_video2(avctx, &pkt, frame, &got);
+	av_frame_free(&frame);
+	if (ret < 0)
+		return ret;
+	if (!got)
+		return 0;
+	if (pkt.data && pkt.data != buf && pkt.size > 0 && pkt.size <= buf_size)
+		memcpy(buf, pkt.data, pkt.size);
+	return pkt.size;
+}
